{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-resets",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "clauderesets.com", "custom_domain": true },
    { "pattern": "www.clauderesets.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-resets",
      "database_id": "8bc08432-7794-4cf8-84b7-a57a67107a83",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  // Public, non-secret settings. Secrets go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "SITE_NAME": "Claude Resets",
    "SITE_URL": "https://clauderesets.com",
    "OWNER_NAME": "Mike",
    "OWNER_X_URL": "",
    "PROJECT_X_URL": "https://x.com/clauderesets",
    "REPO_URL": "https://github.com/silnt-awaken/claude-resets",
    "SUPPORT_URL": "https://buymeacoffee.com/silntawaken",
    "SUPPORT_CONTACT_EMAIL": "silnt.awaken@gmail.com",
    "TELEGRAM_CHANNEL_URL": "https://t.me/clauderesets",
    "BROWSER_ALERTS_ENABLED": "false",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "",
    "ALERTS_PAUSED": "false",
    // Community goal: readers send USDC on Solana to a dedicated treasury wallet, never the operator's
    // personal one; the draw is automatic (finalized block hash). GOAL_USDC_ACCOUNT is that wallet's USDC
    // associated token account (derived 2026-09-18; created on chain by the first USDC transfer).
    "GOAL_ENABLED": "true",
    "GOAL_WALLET": "HXeijhmHirGGp2G112QvwFsQCYEQKQTEExwijZXaCkyC",
    "GOAL_USDC_ACCOUNT": "FdkUsavdzVKodGEDh6QBcGaCZiSV7eM7CTLNLPKWUSZP",
    "GOAL_USDC_MINT": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    // Endpoints tried in order. api.mainnet-beta.solana.com blocks Cloudflare Workers (it sees the Cf-Worker header),
    // publicnode serves them without a key. A keyed endpoint can be added as the GOAL_SOLANA_RPC_PRIVATE secret.
    "GOAL_SOLANA_RPC": "https://solana-rpc.publicnode.com",
    "GOAL_EXPLORER_URL": "https://solscan.io",
    "GOAL_TARGET_USD": "200",
    // Wallets that never win. The goal (treasury) wallet itself is always excluded; nothing else is, so
    // the operator's own contributions from a personal wallet enter the draw like anyone else's.
    "GOAL_EXCLUDED_WALLETS": "",
    "REACTION_COOLDOWN_HOURS": "24",
    "ALERT_MAX_AGE_HOURS": "72"
  }
}
