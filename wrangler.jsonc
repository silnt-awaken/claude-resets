{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-resets",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "clauderesets.com", "custom_domain": true },
    { "pattern": "www.clauderesets.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-resets",
      "database_id": "8bc08432-7794-4cf8-84b7-a57a67107a83",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true },
  // Public, non-secret settings. Secrets go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "SITE_NAME": "Claude Resets",
    "SITE_URL": "https://clauderesets.com",
    "OWNER_NAME": "Mike",
    "OWNER_X_URL": "",
    "PROJECT_X_URL": "https://x.com/clauderesets",
    "SUPPORT_URL": "https://buymeacoffee.com/silntawaken",
    "SUPPORT_CONTACT_EMAIL": "",
    "TELEGRAM_CHANNEL_URL": "",
    "BROWSER_ALERTS_ENABLED": "false",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "",
    "ALERTS_PAUSED": "false",
    "REACTION_COOLDOWN_HOURS": "24",
    "ALERT_MAX_AGE_HOURS": "72"
  }
}
