{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-resets",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "clauderesets.com", "custom_domain": true },
    { "pattern": "www.clauderesets.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-resets",
      "database_id": "8bc08432-7794-4cf8-84b7-a57a67107a83",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true },
  // Public, non-secret settings. Secrets go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "SITE_NAME": "Claude Resets",
    "SITE_URL": "https://clauderesets.com",
    "OWNER_NAME": "Mike",
    "OWNER_X_URL": "",
    "PROJECT_X_URL": "https://x.com/clauderesets",
    "REPO_URL": "https://github.com/silnt-awaken/claude-resets",
    "SUPPORT_URL": "https://buymeacoffee.com/silntawaken",
    "SUPPORT_CONTACT_EMAIL": "silnt.awaken@gmail.com",
    "TELEGRAM_CHANNEL_URL": "https://t.me/clauderesets",
    "BROWSER_ALERTS_ENABLED": "false",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "",
    "ALERTS_PAUSED": "false",
    // Community goal on Robinhood Chain (chain id 4663). Set GOAL_POOL_ADDRESS (a wallet you control) and
    // GOAL_ENABLED to "true" to open it. GOAL_USDG_ADDRESS is Robinhood Chain's native stablecoin USDG (from
    // docs.robinhood.com/chain/contracts; verified on chain 2026-09-18).
    "GOAL_ENABLED": "true",
    "GOAL_POOL_ADDRESS": "0xCA6d06946e498b03112cFE0812C44Ac165dd4747",
    "GOAL_USDG_ADDRESS": "0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168",
    "GOAL_TARGET_USD": "200",
    "RESET_TOKEN_ADDRESS": "0xd3030f41c8e127992516d1fcd58f36601b878f24",
    // RESET is launched on the pons launchpad (a standard token), so burns are transfers from the burner wallet
    // to 0xdEaD ("transfer"). "contract" switches to contracts/ResetToken.sol with burnForReset. Amounts are whole RESET.
    "RESET_BURN_MODE": "transfer",
    "RESET_BURNER_ADDRESS": "0xA0599e6b56bC2E605920b370151b7a530E74C51C",
    "RESET_BURN_PER_RESET": "250000",
    "RESET_BURN_PER_ROUND": "500000",
    "REACTION_COOLDOWN_HOURS": "24",
    "ALERT_MAX_AGE_HOURS": "72"
  }
}
