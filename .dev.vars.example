# Copy to .dev.vars for local development. Never commit .dev.vars.
# Private token used by `npm run content:publish` to call the private publication endpoint.
CONTENT_PUBLISH_TOKEN=change-me-to-a-long-random-string
# Web Push (generate with `npx tsx scripts/vapid-keys.ts`). Public key also goes in wrangler.jsonc vars.
VAPID_PRIVATE_KEY=
# Secret used to sign anonymous reaction identifiers.
REACTION_SECRET=change-me-too
# Optional local Telegram development; keep disabled unless testing with your own bot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=
